# Local Compose settings. Replace password placeholders together with their DSNs.
LOCAL_POSTGRES_PASSWORD=replace-with-local-migration-password
LOCAL_POSTGRES_API_PASSWORD=replace-with-local-api-password
LOCAL_POSTGRES_PORT=5433

# Server-only DSNs. The API role has no application table privileges.
DATABASE_URL=postgresql+psycopg://demoforge_api:replace-with-local-api-password@127.0.0.1:5433/demoforge
MIGRATION_DATABASE_URL=postgresql+psycopg://demoforge:replace-with-local-migration-password@127.0.0.1:5433/demoforge

# Required for workspace routes. For a project using asymmetric signing keys,
# configure issuer and JWKS. Use the project's exact expected token issuer.
# SUPABASE_JWT_ISSUER=https://project-ref.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUDIENCE=authenticated
# For legacy signing (including the default local CLI), configure issuer and
# SUPABASE_JWT_SECRET in the ignored .env instead of setting SUPABASE_JWKS_URL.

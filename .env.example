# Local Compose settings. Replace password placeholders together with their DSNs.
LOCAL_POSTGRES_PASSWORD=replace-with-local-migration-password
LOCAL_POSTGRES_API_PASSWORD=replace-with-local-api-password
LOCAL_POSTGRES_PORT=5433

# Server-only DSNs. The API role has no application table privileges.
DATABASE_URL=postgresql+psycopg://demoforge_api:replace-with-local-api-password@127.0.0.1:5433/demoforge
MIGRATION_DATABASE_URL=postgresql+psycopg://demoforge:replace-with-local-migration-password@127.0.0.1:5433/demoforge

# Required for workspace routes. Configure the project's exact token issuer
# and JWKS URL. These examples use the default local Supabase CLI addresses.
# SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
# SUPABASE_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUDIENCE=authenticated
# For a project configured for legacy HS256 signing, configure issuer and
# SUPABASE_JWT_SECRET in the ignored .env instead of setting SUPABASE_JWKS_URL.

# Discovery ingestion. Use the same Supabase project's Storage API.
# SUPABASE_STORAGE_URL=http://127.0.0.1:54321/storage/v1
# SUPABASE_STORAGE_SERVICE_KEY=replace-with-server-only-storage-key

# Discovery analysis is disabled by default. See docs/ANALYSIS.md.
# DISCOVERY_PROVIDER=disabled
# DISCOVERY_SYNTHETIC_DEV=false
# DISCOVERY_WORKER_DATABASE_URL=postgresql+psycopg://demoforge_worker:replace-with-worker-password@127.0.0.1:54322/postgres
# OPENAI_API_KEY=replace-with-worker-only-openai-key

# Public-facing web origin for sign-in protected links in storyboard exports.
# EXPORT_WEB_ORIGIN=http://localhost:3000
